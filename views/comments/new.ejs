<% include ../partials/header %>

<div class="container">
   <div class="form-wrapper">
      <h1>Add Comment</h1>
      <p class="detail-meta mb-2">for <strong><%= campground.name %></strong></p>
      <form action="/campgrounds/<%= campground._id %>/comments" method="POST">
         <div class="form-group">
            <textarea class="form-control" name="comment[text]" placeholder="Write your comment..." rows="4" required></textarea>
         </div>
         <div class="form-group">
            <button class="btn btn-primary btn-block btn-lg" type="submit">Submit Comment</button>
         </div>
      </form>
      <a class="back-link" href="/campgrounds/<%= campground._id %>">&#8592; Back to Campground</a>
   </div>
</div>

<% include ../partials/footer %>
