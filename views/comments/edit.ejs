<% include ../partials/header %>

<div class="container">
   <div class="form-wrapper">
      <h1>Edit Comment</h1>
      <form action="/campgrounds/<%= campground_id %>/comments/<%= comment._id %>?_method=PUT" method="POST">
         <div class="form-group">
            <textarea class="form-control" name="comment[text]" rows="4" required><%= comment.text %></textarea>
         </div>
         <div class="form-group">
            <button class="btn btn-primary btn-block btn-lg" type="submit">Save Changes</button>
         </div>
      </form>
      <a class="back-link" href="/campgrounds/<%= campground_id %>">&#8592; Back to Campground</a>
   </div>
</div>

<% include ../partials/footer %>
