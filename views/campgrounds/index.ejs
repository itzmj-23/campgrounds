<% include ../partials/header %>

<div class="container">
   <div class="jumbotron mt-3">
      <h1>Welcome to Campgrounds!</h1>
      <p>View our hand-picked campgrounds from all over the world</p>
      <a class="btn btn-success btn-lg" href="/campgrounds/new">Add New Campground</a>
   </div>

   <div class="grid grid-4 mb-3">
      <% campgrounds.forEach(function(campground){ %>
         <div class="card">
            <img class="card-img" src="<%= campground.image %>" alt="<%= campground.name %>">
            <div class="card-body">
               <h4 class="card-title"><%= campground.name %></h4>
               <a href="/campgrounds/<%= campground._id %>" class="btn btn-primary btn-sm">More Info</a>
            </div>
         </div>
      <% }) %>
   </div>
</div>

<% include ../partials/footer %>
