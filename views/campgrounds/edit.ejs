<% include ../partials/header %>

<div class="container">
   <div class="form-wrapper">
      <h1>Edit Campground</h1>
      <form action="/campgrounds/<%= campground._id %>/?_method=PUT" method="POST">
         <div class="form-group">
            <input class="form-control" type="text" name="campground[name]" value="<%= campground.name %>" placeholder="Name" required>
         </div>
         <div class="form-group">
            <input class="form-control" type="number" name="campground[price]" value="<%= campground.price %>" min="0.01" step="0.01" required>
         </div>
         <div class="form-group">
            <input class="form-control" type="url" name="campground[image]" value="<%= campground.image %>" placeholder="Image URL" required>
         </div>
         <div class="form-group">
            <textarea class="form-control" name="campground[description]" placeholder="Description" rows="4" required><%= campground.description %></textarea>
         </div>
         <div class="form-group">
            <button class="btn btn-primary btn-block btn-lg" type="submit">Save Changes</button>
         </div>
      </form>
      <a class="back-link" href="/campgrounds/<%= campground._id %>">&#8592; Back to Campground</a>
   </div>
</div>

<% include ../partials/footer %>
